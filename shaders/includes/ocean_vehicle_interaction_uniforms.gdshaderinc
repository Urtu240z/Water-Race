const int MAX_DIRECTIONAL_WAKE_SAMPLES = 16;
const int MAX_LANDING_IMPACTS = 4;

group_uniforms LandingImpacts;
uniform bool landing_impacts_enabled = true;
uniform int landing_impact_effective_count : hint_range(1, 4, 1) = 4;
uniform int landing_impact_active[4];
uniform vec2 landing_impact_positions[4];
uniform float landing_impact_start_times[4];
uniform float landing_impact_strengths[4];
uniform vec2 landing_impact_directions[4];
uniform vec2 landing_impact_half_extents[4];
uniform vec2 landing_impact_secondary_a_offsets[4];
uniform vec2 landing_impact_secondary_b_offsets[4];
uniform vec2 landing_impact_secondary_weights[4];
uniform int landing_impact_entry_types[4];
uniform int landing_impact_contact_masks[4];
uniform float landing_impact_amplitudes[4];
uniform float landing_impact_depressions[4];
uniform float landing_impact_initial_radii[4];
uniform float landing_impact_speeds[4];
uniform float landing_impact_wavelengths[4];
uniform float landing_impact_durations[4];
uniform bool landing_impact_exaggerated_debug = false;
uniform float landing_impact_debug_multiplier : hint_range(1.0, 5.0, 0.25) = 2.5;

group_uniforms LandingImpactFoam;
uniform bool landing_foam_enabled = true;
uniform float landing_foam_strength : hint_range(0.0, 2.0, 0.01) = 0.035;
uniform float landing_foam_minimum_impact_strength : hint_range(0.0, 1.0, 0.01) = 0.35;
uniform float landing_foam_energy_threshold : hint_range(0.0, 1.0, 0.01) = 0.18;
uniform float landing_foam_energy_softness : hint_range(0.01, 0.5, 0.01) = 0.12;
uniform float landing_foam_generic_crest_suppression : hint_range(0.0, 1.0, 0.01) = 1.0;

group_uniforms DirectionalWake;
uniform bool directional_wake_enabled = true;
uniform int directional_wake_active_count = 0;
uniform int directional_wake_effective_count : hint_range(1, 16, 1) = 16;
uniform vec2 directional_wake_start_positions[16];
uniform vec2 directional_wake_end_positions[16];
uniform float directional_wake_start_times[16];
uniform float directional_wake_end_times[16];
uniform float directional_wake_intensities[16];
uniform float directional_wake_widths[16];
uniform float directional_wake_biases[16];
uniform float directional_wake_speeds[16];
uniform float directional_wake_amplitude : hint_range(0.0, 0.5, 0.005) = 0.16;
uniform float directional_wake_wavelength : hint_range(0.25, 12.0, 0.05) = 2.4;
uniform float directional_wake_propagation_speed : hint_range(0.0, 12.0, 0.05) = 2.8;
uniform float directional_wake_opening_slope : hint_range(0.0, 0.5, 0.005) = 0.085;
uniform float directional_wake_arm_width : hint_range(0.1, 4.0, 0.05) = 0.62;
uniform float directional_wake_center_depression : hint_range(0.0, 0.5, 0.005) = 0.065;
uniform float directional_wake_maximum_distance : hint_range(4.0, 100.0, 1.0) = 46.0;
uniform float directional_wake_duration : hint_range(0.25, 12.0, 0.05) = 5.2;
uniform float directional_wake_attenuation : hint_range(0.0, 1.0, 0.005) = 0.16;
uniform float directional_wake_turn_strength : hint_range(0.0, 2.0, 0.01) = 0.65;

group_uniforms HullPressure;
uniform bool hull_pressure_enabled = true;
uniform vec2 hull_pressure_center = vec2(0.0);
uniform vec2 hull_pressure_forward = vec2(0.0, -1.0);
uniform vec2 hull_pressure_half_extents = vec2(0.6, 1.45);
uniform float hull_pressure_contact = 0.0;
uniform float hull_pressure_intensity = 0.0;
uniform float hull_pressure_left_strength = 0.0;
uniform float hull_pressure_right_strength = 0.0;
uniform float hull_pressure_turn_bias = 0.0;
uniform float hull_pressure_pitch = 0.0;
uniform float hull_pressure_amplitude : hint_range(0.0, 0.5, 0.005) = 0.14;
uniform float hull_pressure_depression_strength : hint_range(0.0, 2.0, 0.01) = 0.72;
uniform float hull_pressure_maximum_distance : hint_range(2.0, 30.0, 0.25) = 9.0;

group_uniforms VehicleInteraction;
uniform float vehicle_interaction_maximum_displacement : hint_range(0.05, 2.0, 0.01) = 0.55;
uniform float vehicle_interaction_maximum_derivative : hint_range(0.1, 4.0, 0.05) = 1.35;
uniform float vehicle_interaction_clipmap_distance : hint_range(8.0, 200.0, 1.0) = 86.0;
uniform int ocean_interaction_debug_mode : hint_enum("Off", "Ripples", "Directional Wake", "Hull Pressure", "Total") = 0;
uniform bool vehicle_interaction_exaggerated_debug = false;
uniform float vehicle_interaction_debug_multiplier : hint_range(1.0, 8.0, 0.25) = 3.5;
group_uniforms;
